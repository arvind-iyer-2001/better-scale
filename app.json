{
  "expo": {
    "name": "better-scale",
    "slug": "better-scale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.arvindiyer.betterscale",
      "infoPlist": {
        "UIBackgroundModes": ["bluetooth-central"]
      }
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "better-scale listens for your scale to record weigh-ins."
        }
      ],
      "expo-sqlite",
      "expo-dev-client",
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "better-scale reads your Health data to avoid duplicate entries.",
          "NSHealthUpdateUsageDescription": "better-scale saves your weigh-ins to Apple Health."
        }
      ]
    ]
  }
}
